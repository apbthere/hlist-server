# Copy to .env (next to compose.yml) and fill in.

# Public name of the server; Caddy requests the certificate for it.
HLIST_DOMAIN=your-name.myqnapcloud.com

# Needed to create an account. Use something long and random, e.g. the output of:
#   openssl rand -base64 18
HLIST_INVITE_CODE=

# NAS ports Caddy listens on (QTS already uses 80, 443 and 8080).
# Forward the router's external 80 -> HTTP_PORT and 443 -> HTTPS_PORT on the NAS.
HTTP_PORT=8880
HTTPS_PORT=8443
